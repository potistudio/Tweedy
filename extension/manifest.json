{
	"manifest_version": 3,
	"name": "Tweedy",
	"version": "1.0.0",
	"description": " Tidy Tweets",
	"minimum_chrome_version": "116",
	"permissions": ["storage", "unlimitedStorage"],
	"host_permissions": ["https://x.com/*", "https://*.twimg.com/*"],
	"background": {
		"service_worker": "src/background.js",
		"type": "module"
	},
	"action": {
		"default_title": "Tweedyを開く",
		"default_icon": {
			"16": "icons/icon16.png",
			"32": "icons/icon32.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"icons": {
		"16": "icons/icon16.png",
		"32": "icons/icon32.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"content_scripts": [
		{
			"matches": ["https://x.com/*"],
			"js": ["src/parse.js", "src/inject.js"],
			"run_at": "document_start",
			"world": "MAIN"
		},
		{
			"matches": ["https://x.com/*"],
			"js": ["src/goo.js", "src/content.js"],
			"css": ["src/content.css"],
			"run_at": "document_start"
		}
	],
	"web_accessible_resources": [
		{
			"resources": ["src/parse.js"],
			"matches": ["https://x.com/*"]
		}
	]
}
